{
  "name": "duh-schema",
  "version": "1.0.0",
  "description": "DUH Schema",
  "main": "lib/index.js",
  "unpkg": "dist/schema.js",
  "scripts": {
    "test": "eslint lib/ test/ && c8 --reporter=text --reporter=lcov mocha",
    "build": "esbuild lib/index.js --bundle --format=iife --global-name=schema --outfile=dist/schema.js",
    "prepare": "node bin/prepare.js && npm run build"
  },
  "files": [
    "lib",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sifive/duh-schema.git"
  },
  "author": "SiFive",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/sifive/duh-schema/issues"
  },
  "homepage": "https://github.com/sifive/duh-schema#readme",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@drom/eslint-config": "^1.0.0",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "c8": "^12.0.0",
    "chai": "^5.3.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.0.0",
    "mocha": "^12.0.1"
  }
}
